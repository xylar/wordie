# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.eggs/

# Testing / typing / linting caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Environments
.pixi/
.venv/
venv/
env/

# Web build output and dependencies
web/node_modules/
web/dist/
# vitest drops its cache beside whatever directory it was invoked from, which
# is not always web/.
.vite/

# Source datasets are large and are not redistributable: BedMachine v4 is 1.2
# GB and both it and the MEaSUREs boundaries sit behind an Earthdata Login.
# They get downloaded by hand, often straight into this directory, so the
# patterns below are deliberately broad -- committing one by accident would be
# a nuisance to undo and worse to publish. Only the small derived outlines
# under web/public/data/ are tracked.
data/cache/
*.nc
*.crdownload
IceBoundaries_Antarctica_*
NSIDC-*

# Editors / OS
.vscode/
.idea/
*.swp
.DS_Store
